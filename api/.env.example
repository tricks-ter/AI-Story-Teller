# Required: Your Z.AI API key from https://bigmodel.cn or z.ai
ZAI_API_KEY=your-api-key-here

# Optional: Comma-separated list of allowed frontend origins (CORS)
# Defaults to localhost dev URLs. Set to your deployed frontend URL in production.
# ALLOWED_ORIGINS=https://your-app.vercel.app,https://yourusername.github.io

# Optional: Directory to store chat_history.json
# Defaults to /tmp (writable on Vercel serverless functions).
# On Render with a persistent disk, override this to your mount path:
# DATA_DIR=/data
